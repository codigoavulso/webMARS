 class MetricsTests(unittest.TestCase):
+    def test_manual_views_are_grouped_and_do_not_count_as_simulator_sessions(self):
+        now = 1788600000
+        base = dict(v=2, surface="manual", context="public", automation="none", interaction="not_seen", visit="none")
+        chapter = event(event="manual_chapter_view", detail="part_3", **base)
+        self.assertTrue(metrics.validate_event(chapter))
+        for changes in ({"surface": "app"}, {"detail": "#/personal-url"}, {"event": "assemble_success"}, {"seconds": 4}):
+            self.assertFalse(metrics.validate_event({**chapter, **changes}))
+        metrics.record(self.database, event(event="page_view", **base), now=now - 2)
+        metrics.record(self.database, chapter, now=now - 1)
+        metrics.record(self.database, {**chapter, "session": "b" * 32, "context": "test"}, now=now)
+        metrics.record(self.database, event(session="c" * 32), now=now)
+        public = metrics.public_statistics(self.database, now=now, audience="public")
+        self.assertEqual(public["totals"]["sessions"], 1)
+        self.assertEqual(public["manual"], {"sessions": 1, "page_views": 1, "chapter_views": 1,
+                         "parts": [{"key": "part_3", "chapter_views": 1}]})
+        self.assertEqual(metrics.public_statistics(self.database, now=now, audience="test")["manual"]["sessions"], 1)
+        self.assertEqual(metrics.report(self.database, now=now)["manual"]["chapter_views"], 2)
+
