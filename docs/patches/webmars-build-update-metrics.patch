     return data
 
 
+def build_update(**changes):
+    data = event(v=2, event="build_update_attempted", context="public", automation="none", interaction="not_seen",
+                 visit="none", update_id="d" * 32, from_build_id="e" * 64, to_build_id="f" * 64)
+    data.update(changes)
+    return data
+
+
 class MetricsTests(unittest.TestCase):
+    def test_build_update_validation_and_duplicate_acknowledgement(self):
+        now = 1788600000
+        for changes in ({"update_id": "private"}, {"to_build_id": "private"}, {"to_build_id": "e" * 64},
+                        {"surface": "learn"}, {"seconds": 60}, {"source": "private"}, {"event": "app_ready"}):
+            with self.subTest(changes=changes):
+                self.assertFalse(metrics.validate_event(build_update(**changes)))
+        metrics.record(self.database, build_update(), now=now - 3)
+        metrics.record(self.database, build_update(), now=now - 2)
+        with self.assertRaises(ValueError):
+            metrics.record(self.database, build_update(event="build_update_completed", from_build_id="a" * 64), now=now - 1)
+        complete = build_update(event="build_update_completed", session="b" * 32)
+        metrics.record(self.database, complete, now=now - 1)
+        metrics.record(self.database, complete, now=now)
+        metrics.record(self.database, build_update(context="internal", session="c" * 32, update_id="0" * 32), now=now)
+        result = metrics.public_statistics(self.database, now=now, audience="public")
+        self.assertEqual(result["analysis"]["build_updates"], [
+            {"key": "build_update_attempted", "events": 1, "sessions": 1},
+            {"key": "build_update_completed", "events": 1, "sessions": 1},
+        ])
+        internal = metrics.public_statistics(self.database, now=now, audience="internal")
+        self.assertEqual(internal["analysis"]["build_updates"][0]["events"], 1)
+        self.assertNotIn("d" * 32, json.dumps(result))
+        self.assertNotIn("e" * 64, json.dumps(result))
+        self.assertEqual(result["totals"]["events"], 2)
+        self.assertEqual(result["totals"]["interacting_sessions"], 0)
+        self.assertEqual(result["totals"]["presence_seconds"], 0)
+
